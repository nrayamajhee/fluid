//! Every `html!` block of nrayamajhee/studio `web-rust/src/ui`, verbatim
//! (edition 2024), over stub state. Generated by `compat/scripts/extract.py`;
//! it only has to compile, so the stubs mirror the real types' shapes.
#![allow(dead_code, unused_variables, clippy::all)]

use std::collections::{BTreeMap, BTreeSet};
use std::rc::Rc;

use fluid::{Context, Signal};
use fluid_macro::html;
use wasm_bindgen::prelude::*;
use web_sys::Element;

pub struct Piece {
  pub face: &'static str,
  pub name: &'static str,
}
pub struct Param {
  pub name: &'static str,
  pub values: &'static [&'static str],
}
pub struct Preset {
  pub name: &'static str,
  pub engine: &'static str,
  pub params: &'static [Param],
  pub pieces: Option<&'static [Piece]>,
}
pub static PRESETS: [Preset; 1] = [Preset {
  name: "Piano",
  engine: "FM",
  params: &[Param { name: "Tone", values: &["1"] }],
  pieces: None,
}];
pub const KNOB_STEPS: usize = 11;

#[derive(Clone, Copy, PartialEq, Eq)]
pub enum Theme {
  System,
  Light,
  Dark,
}
impl Theme {
  pub fn next(self, _system_dark: bool) -> Self {
    Self::Light
  }
}
#[derive(PartialEq, Eq)]
pub enum Job {
  Preset(usize),
  Chord(usize),
  Shift,
}
pub struct Pad {
  pub job: Job,
}
pub struct KeyStyle {
  pub rest: &'static str,
  pub lit: &'static str,
  pub labels: &'static str,
  pub hotkey: &'static str,
  pub note: &'static str,
}
pub struct Device;
impl Device {
  pub fn cycle_theme(&self) {}
}
mod notes {
  pub fn engraved(_midi: u8) -> String {
    String::new()
  }
  pub fn midi(semitone: u8, _octave: i8) -> u8 {
    semitone
  }
}
fn octave_label(octave: i8) -> String {
  octave.to_string()
}
fn unsaved(_preset: usize, _values: &[Vec<usize>]) -> bool {
  false
}
fn unsaved_mark() -> String {
  String::new()
}
const LINK: &str = "underline";
const OVERLAY: &str = "absolute";
const CORNER_BUTTON: &str = "button";
const ICON: &str = "icon";
const SUN: &str = "<svg></svg>";
const MOON: &str = "<svg></svg>";
const PAD: &str = "pad";
const PAD_HELD: &str = "pad held";
const PAD_LIT: &str = "pad lit";
const PAD_LIT_HELD: &str = "pad lit held";
const LED: &str = "led";
const LED_ON: &str = "led on";
const HOTKEY: &str = "hotkey";
const FACE: &str = "face";

